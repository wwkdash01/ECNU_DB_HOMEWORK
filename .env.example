# 复制为 .env 后填入真实值：
#   cp .env.example .env
# .env 已被 .gitignore 屏蔽，本示例文件可以安全提交。

# 只填你要用的那个 provider 的密钥即可，其余留空。
DEEPSEEK_API_KEY=sk-your-key-here
# DASHSCOPE_API_KEY=sk-xxx        # 阿里云百炼 / Qwen
# OPENAI_API_KEY=sk-xxx           # OpenAI
# ZHIPU_API_KEY=xxx               # 智谱 GLM
# MOONSHOT_API_KEY=sk-xxx         # Moonshot / Kimi

# 默认 provider（对应 config.PROVIDERS 的键）；不设则为 deepseek-flash。
# 也可以每次运行时用 --model 覆盖。
# DB_AGENT_MODEL=deepseek-flash

# 任意 OpenAI 兼容服务：定义 custom provider
# LLM_MODEL=your-model
# LLM_BASE_URL=https://your-endpoint/v1
# LLM_API_KEY_ENV=LLM_API_KEY
# LLM_API_KEY=sk-xxx

# 自建 OpenAI 兼容网关（vllm 部署）。端点不写死在仓库里，必须自己提供。
# 思考开关用 chat_template_kwargs.enable_thinking=false；
# 带 -nothink 后缀的 provider（proxy-ds-nothink / proxy-glm-nothink）已内置该开关。
# PROXY_BASE_URL=https://your-gateway.example.com/v1
# PROXY_API_KEY=sk-xxx

# Kimi 的模型名单独用 MOONSHOT_MODEL，避免与 custom 的 LLM_MODEL 抢变量
# MOONSHOT_MODEL=moonshot-v1-8k
